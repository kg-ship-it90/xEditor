{
  "name": "xEditor Studio",
  "short_name": "xEditor",
  "start_url": "./index.html",
  "display": "standalone",
  "theme_color": "#0b0d13",
  "background_color": "#0b0d13",
  "icons": [
    {
      "src": "https://cdn-icons-png.flaticon.com/512/1006/1006509.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt", ".js", ".json", ".html", ".css", ".md", ".csv", ".env", ".ts", ".py"]
      }
    }
  ]
}